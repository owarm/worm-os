diff --git a/res/xml/network_security_config.xml b/res/xml/network_security_config.xml
index 95bafb3..148c30e 100644
--- a/res/xml/network_security_config.xml
+++ b/res/xml/network_security_config.xml
@@ -2,7 +2,7 @@
 <network-security-config>
     <base-config cleartextTrafficPermitted="false"/>
     <domain-config>
-        <domain includeSubdomains="true">releases.grapheneos.org</domain>
+        <domain includeSubdomains="true">worm.estixari.com</domain>
         <!-- expiration is updated monthly to be approximately 3 months ahead -->
         <pin-set expiration="2026-10-01">
             <!-- ISRG Root X1 -->
